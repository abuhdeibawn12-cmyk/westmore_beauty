.drawer-backdrop { position: fixed; inset: 0; background: #0007; z-index: 90; }
.cart-drawer { position: fixed; z-index: 100; inset: 0 0 0 auto; width: min(96vw, 540px); background: #fff; transform: translateX(105%); transition: transform .3s ease; display: flex; flex-direction: column; box-shadow: -8px 0 30px #0002; }
.cart-drawer.open { transform: translateX(0); }.drawer-header { flex: 0 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 22px 26px; border-bottom: 1px solid var(--line); }.drawer-header h2 { font-size: 30px; }.drawer-close { border: 0; background: none; font-size: 38px; cursor: pointer; }.drawer-empty { margin: auto; color: var(--muted); }.drawer-items { flex: 1 1 auto; min-height: 0; overflow-y: auto; }.drawer-line { padding: 26px; display: grid; grid-template-columns: 100px minmax(0, 1fr) auto; gap: 16px; border-bottom: 1px solid var(--line); }.drawer-product-image { display: block; width: 100px; height: 125px; }.drawer-line img { width: 100px; height: 125px; object-fit: cover; }.drawer-line h3 { margin: 0; font-family: "Ivy Presto", Georgia, serif; font-size: 22px; }.drawer-product-name { color: inherit; text-decoration: none; }.drawer-product-name:hover { text-decoration: underline; text-underline-offset: 3px; }.drawer-line p { margin: 5px 0; font-size: 14px; color: var(--muted); }.quantity { width: 94px; border: 1px solid var(--line); display: grid; grid-template-columns: repeat(3, 1fr); align-items: center; text-align: center; margin-top: 12px; }.quantity button { border: 0; background: transparent; cursor: pointer; padding: 6px; }.drawer-line-meta { min-width: 74px; display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; gap: 18px; }.drawer-line-meta strong { white-space: nowrap; }.drawer-line-meta button { border: 0; background: transparent; padding: 0; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; font-size: 13px; cursor: pointer; }.drawer-footer { flex: 0 0 auto; margin-top: auto; border-top: 1px solid var(--line); padding: 22px 26px; background: #fff; }.drawer-footer div { display: flex; justify-content: space-between; font-size: 20px; }.drawer-footer p { color: var(--muted); font-size: 13px; }.drawer-footer > button { width: 100%; border: 0; background: var(--ink); color: #fff; padding: 15px; text-transform: uppercase; font-weight: 700; cursor: pointer; }.drawer-footer > button:disabled { opacity: .45; cursor: not-allowed; }
.shade-modal { position: fixed; inset: 0; z-index: 110; background: #0008; display: grid; place-items: center; padding: 20px; }.shade-modal-card { width: min(650px, 100%); background: var(--cream); padding: 50px; text-align: center; position: relative; }.shade-modal-card h2 { font-size: 44px; }.shade-modal-close { position: absolute; top: 10px; right: 16px; border: 0; background: none; font-size: 36px; cursor: pointer; }.shade-quiz { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 28px; }.shade-quiz button { border: 1px solid var(--ink); background: #fff; padding: 15px; cursor: pointer; }.shade-quiz button:hover { background: var(--lilac); }.shade-result { min-height: 24px; font-weight: 600; }
.shade-modal[hidden] { display: none; }
.quick-view-modal { position: fixed; inset: 0; z-index: 120; display: grid; place-items: center; padding: 20px; background: #0007; }
.quick-view-modal[hidden] { display: none; }
.quick-view-card { width: min(525px, 100%); min-height: 310px; border-radius: 8px; background: #fff; padding: 29px; position: relative; box-shadow: 0 4px 14px #0004; }
.quick-view-close { position: absolute; top: 14px; right: 20px; border: 0; background: transparent; font: 34px/1 Arial, sans-serif; cursor: pointer; }
.quick-view-header { display: grid; grid-template-columns: 72px 1fr; gap: 14px; align-items: start; padding-right: 42px; }
.quick-view-header > img { width: 72px; height: 72px; object-fit: cover; background: #f6f1ee; }
.quick-product-link { display: block; width: 72px; height: 72px; background: #f6f1ee; }
.quick-product-link img { width: 100%; height: 100%; object-fit: cover; }
.quick-view-header h2 a { color: inherit; text-decoration: none; }
.quick-view-header h2 a:hover { text-decoration: underline; text-underline-offset: 2px; }
.quick-view-header h2 { font-family: "Barlow Semi Condensed", Arial, sans-serif; font-size: 16px; line-height: 1.2; font-weight: 700; text-transform: uppercase; margin: 2px 0 4px; }
.quick-price { margin: 0 0 5px; }.quick-price s { margin-right: 7px; color: var(--muted); }
.quick-review-link { border: 0; background: transparent; padding: 0; cursor: pointer; }
.quick-review-link:hover { text-decoration: underline; text-underline-offset: 3px; }
.quick-shades, .quick-colors { border: 0; padding: 0; margin: 18px 0 0; }
.quick-shades legend, .quick-colors legend { margin-bottom: 8px; }.quick-shades legend strong, .quick-colors legend strong { text-transform: uppercase; }
.quick-shades > div { display: grid; grid-template-columns: repeat(8, 37px); gap: 9px; }
.quick-shades label { width: 37px; height: 37px; position: relative; border-radius: 50%; cursor: pointer; padding: 2px; }
.quick-shades input { position: absolute; opacity: 0; }.quick-shades img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
.quick-shades label:has(input:checked) { outline: 1.5px solid var(--ink); outline-offset: 2px; }
.quick-shades label::after { content: attr(data-shade-label); position: absolute; z-index: 8; left: 50%; bottom: calc(100% + 10px); width: max-content; max-width: 94px; transform: translate(-50%, 4px); border-radius: 2px; background: var(--ink); color: #fff; padding: 7px 9px; font-size: 14px; font-weight: 600; line-height: 1.25; text-align: center; white-space: normal; opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .15s ease, transform .15s ease; }
.quick-shades label::before { content: ""; position: absolute; z-index: 8; left: 50%; bottom: calc(100% + 4px); transform: translateX(-50%); border: 6px solid transparent; border-top-color: var(--ink); opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .15s ease; }
.quick-shades label:hover::after, .quick-shades label:focus-within::after { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
.quick-shades label:hover::before, .quick-shades label:focus-within::before { opacity: 1; visibility: visible; }
.quick-colors > div { display: flex; gap: 10px; }
.quick-colors button { border: 1px solid #c7af93; border-radius: 99px; background: #fff; padding: 11px 22px; cursor: pointer; }
.quick-colors button.selected { border-color: var(--ink); background: var(--lilac-pale); }
.quick-colors button.unavailable { color: #6a6a70; border-color: #aaa; background: linear-gradient(135deg, #eceef0 0%, #c4c8cd 48%, #e5e7e9 100%); cursor: not-allowed; position: relative; }
.quick-colors button small { display: block; font-size: 10px; line-height: 1; margin-top: 2px; text-transform: uppercase; }
.quick-add { display: block; margin: 25px 0 0 auto; border: 0; border-radius: 7px; background: var(--ink); color: #fff; padding: 14px 24px; min-width: 118px; text-transform: uppercase; font-weight: 600; cursor: pointer; }
.customers-say-backdrop { position: fixed; inset: 0; z-index: 130; background: #0005; }
.customers-say-drawer { position: fixed; z-index: 140; inset: 0 0 0 auto; width: min(92vw, 415px); overflow-y: auto; background: #fff; padding: 24px 27px 36px; box-shadow: -8px 0 24px #0003; transform: translateX(105%); transition: transform .28s ease; }
.customers-say-drawer.open { transform: translateX(0); }
.customers-say-close { position: absolute; top: 14px; right: 19px; border: 0; background: transparent; font: 28px/1 Arial, sans-serif; cursor: pointer; }
.customers-say-drawer h2 { font-size: 20px; padding-right: 35px; }
.customers-say-intro { margin: 7px 0 14px; padding-bottom: 13px; border-bottom: 1px solid var(--line); }
.customer-topic { margin-bottom: 17px; }.customer-topic h3 { font-size: 15px; margin: 0 0 2px; }.customer-topic h3 span { display: inline-block; width: 21px; }.customer-topic p { margin: 0 0 2px; line-height: 1.35; }.customer-topic strong { font-size: 13px; }
.review-highlights { border-top: 1px solid var(--line); padding-top: 12px; }.review-highlights h3 { font-size: 14px; margin: 0 0 12px; }.review-highlights blockquote { margin: 0 0 9px 18px; line-height: 1.35; }.review-highlights cite { font-size: 12px; }
.toast { position: fixed; z-index: 130; left: 50%; bottom: 25px; transform: translate(-50%, 40px); background: var(--ink); color: #fff; padding: 12px 18px; opacity: 0; pointer-events: none; transition: .25s ease; }.toast.show { opacity: 1; transform: translate(-50%, 0); }

@media (max-width: 900px) {
  .desktop-nav, .account-button { display: none; }
  .header-main { height: 64px; }
  .page-width { width: min(100% - 30px, var(--page)); }
  .breadcrumbs { overflow: hidden; white-space: nowrap; font-size: 13px; }
  .product { grid-template-columns: 1fr; gap: 20px; width: 100%; }
  .gallery { position: static; }
  .gallery-main { aspect-ratio: 1; }
  .gallery-thumbnails { padding: 0 15px; overflow-x: auto; grid-template-columns: repeat(11, 72px); }
  .gallery-arrow { opacity: 1; }
  .product-info { padding: 18px 20px 0; }
  h1 { font-size: 32px; }
  .clinical-inner { grid-template-columns: 1fr; gap: 30px; }
