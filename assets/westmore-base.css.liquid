.footer { min-height: 420px; background: #1e1a34; color: #fff; padding: 30px 0 18px; }
.footer-grid { min-height: 370px; display: grid; grid-template-columns: minmax(270px, 1.55fr) minmax(145px, .75fr) minmax(230px, 1fr); gap: 75px; align-content: start; padding-top: 4px; }
