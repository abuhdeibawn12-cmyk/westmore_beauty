.review-list { min-height: 635px; }
.review-row { display: grid; grid-template-columns: 135px minmax(0, 1fr) 82px; gap: 22px; min-height: 127px; padding: 30px 0 25px; border-bottom: 1px solid var(--line); }
.review-author { font-size: 13px; line-height: 1.2; }
.review-author p { margin: 0 0 3px; }
.verified-buyer { display: flex; align-items: center; gap: 4px; font-size: 11px; }
.verified-buyer::before { content: "✓"; width: 13px; height: 13px; display: grid; place-items: center; border-radius: 50%; background: var(--ink); color: #fff; font: 700 9px/1 Arial, sans-serif; }
.review-copy { min-width: 0; }
.review-heading { display: flex; align-items: center; gap: 14px; margin-bottom: 15px; }
.review-heading .stars { flex: 0 0 auto; font-size: 16px; letter-spacing: 1px; line-height: 1; }
