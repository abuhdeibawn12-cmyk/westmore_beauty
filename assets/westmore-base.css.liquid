:root {
  --ink: #1e1a34;
  --muted: #66616d;
  --lilac: #ccccff;
  --lilac-pale: #f1f0ff;
  --tan: #ead3bd;
  --cream: #fbf8f4;
  --line: #d9d5d1;
  --page: 1160px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  color: var(--ink);
  font-family: "Barlow Semi Condensed", Arial, sans-serif;
  font-size: 16px;
  line-height: 1.5;
  background: #fff;
}
body.no-scroll { overflow: hidden; }
button, input, select { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
button { color: inherit; }
img { max-width: 100%; display: block; }
a { color: inherit; }
.page-width { width: min(var(--page), calc(100% - 48px)); margin-inline: auto; }
.sr-only, .skip-link:not(:focus) { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
.skip-link { position: fixed; z-index: 100; top: 12px; left: 12px; background: #fff; padding: 10px 16px; }

.announcement { height: 44px; display: grid; place-items: center; background: var(--lilac); font-size: 15px; font-weight: 600; }
.site-header { background: #fff; border-bottom: 1px solid #eee; position: relative; z-index: 20; }
.header-main { height: 66px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
.logo { width: 162px; }
.logo img { width: 100%; }
.header-actions { justify-self: end; display: flex; gap: 14px; align-items: center; }
.icon-button { width: 30px; height: 30px; border: 0; background: transparent; padding: 4px; cursor: pointer; position: relative; }
.icon-button svg { fill: none; stroke: currentColor; stroke-width: 1.7; width: 100%; height: 100%; }
.cart-count { position: absolute; right: -7px; top: -6px; min-width: 17px; height: 17px; padding: 0 4px; border-radius: 99px; background: var(--ink); color: white; font-size: 11px; display: none; place-items: center; }
.cart-count.visible { display: grid; }
.menu-button { justify-self: start; }
.desktop-nav { display: flex; justify-content: center; gap: 42px; padding: 7px 20px 18px; }
.desktop-nav a { text-decoration: none; font-size: 16px; }
.desktop-nav a:hover { text-decoration: underline; text-underline-offset: 5px; }
.mobile-nav { position: fixed; inset: 0 auto 0 0; width: min(88vw, 380px); background: #fff; z-index: 100; padding: 88px 34px 34px; box-shadow: 10px 0 30px #0002; }
.mobile-nav a { display: block; text-decoration: none; border-bottom: 1px solid var(--line); padding: 16px 0; font-size: 22px; }
.mobile-nav-close { position: absolute; top: 22px; right: 25px; font-size: 38px; background: none; border: 0; cursor: pointer; }

.breadcrumbs { display: flex; gap: 5px; color: #4f4b54; font-size: 15px; padding: 24px 0 17px; }
.breadcrumbs a { text-decoration: none; }
.product { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(390px, .92fr); gap: 66px; align-items: start; }
.gallery { min-width: 0; position: sticky; top: 24px; }
.gallery-main { aspect-ratio: 1 / 1; background: #f5ece7; position: relative; overflow: hidden; }
.gallery-main > img { width: 100%; height: 100%; object-fit: cover; transition: opacity .2s ease; }
.gallery-arrow { position: absolute; z-index: 2; top: 50%; transform: translateY(-50%); width: 40px; height: 52px; border: 0; background: #fff9; font-family: Arial, sans-serif; font-size: 36px; line-height: 1; cursor: pointer; opacity: 0; transition: opacity .2s; }
.gallery:hover .gallery-arrow { opacity: 1; }
.gallery-prev { left: 10px; }.gallery-next { right: 10px; }
.gallery-counter { position: absolute; right: 14px; bottom: 14px; background: #fffc; padding: 5px 10px; font-size: 13px; }
.gallery-thumbnails { display: grid; grid-template-columns: repeat(11, minmax(0, 1fr)); gap: 6px; margin-top: 8px; }
.gallery-thumb { aspect-ratio: 1; border: 1px solid transparent; padding: 0; background: #f5ece7; cursor: pointer; overflow: hidden; }
.gallery-thumb.active { border: 2px solid var(--ink); }
.gallery-thumb img { width: 100%; height: 100%; object-fit: cover; }

.product-info { padding-top: 28px; }
h1, h2 { font-family: "Ivy Presto", Georgia, serif; font-weight: 400; line-height: 1; margin: 0; }
h1 { font-size: 32px; }
.eyebrow { margin: 5px 0 8px; text-transform: uppercase; font-size: 16px; font-weight: 700; line-height: 1.2; }
.review-link { display: inline-flex; align-items: center; gap: 10px; font-size: 14px; text-decoration: none; margin: 5px 0 26px; }
.stars { color: #c4873f; letter-spacing: 1px; }
.option-group { border: 0; margin: 0 0 13px; padding: 0; }
.option-group legend { text-transform: none; margin-bottom: 10px; font-size: 16px; }
.option-group legend strong { text-transform: uppercase; }
.shade-grid { display: grid; grid-template-columns: repeat(5, 40px); gap: 12px 13px; }
.shade-option { width: 40px; height: 40px; border-radius: 50%; cursor: pointer; position: relative; padding: 2px; }
.shade-option input { position: absolute; opacity: 0; }
.shade-option img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
.shade-option:has(input:checked) { outline: 1.5px solid var(--ink); outline-offset: 2px; }
.shade-option::after { content: attr(data-shade-label); position: absolute; z-index: 15; left: 50%; bottom: calc(100% + 12px); width: max-content; max-width: 108px; transform: translate(-50%, 5px); border-radius: 1px; background: var(--ink); color: #fff; padding: 8px 10px; font-size: 14px; font-weight: 600; line-height: 1.3; text-align: center; white-space: normal; opacity: 0; visibility: hidden; pointer-events: none; box-shadow: 0 4px 9px #0003; transition: opacity .14s ease, transform .14s ease, visibility .14s ease; }
.shade-option::before { content: ""; position: absolute; z-index: 15; left: 50%; bottom: calc(100% + 2px); transform: translateX(-50%); border: 6px solid transparent; border-top-color: var(--ink); opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .14s ease, visibility .14s ease; }
.shade-option:hover::after, .shade-option:focus-within::after { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
.shade-option:hover::before, .shade-option:focus-within::before { opacity: 1; visibility: visible; }
.text-button { border: 0; background: transparent; text-transform: uppercase; text-decoration: underline; text-underline-offset: 3px; font-weight: 600; padding: 0; cursor: pointer; }
.shade-finder { margin: 3px 0 21px; }
.size-options { display: flex; gap: 10px; }
.size-options label { position: relative; cursor: pointer; }
.size-options input { position: absolute; opacity: 0; }
.size-options span { min-width: 72px; height: 52px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 7px; font-weight: 600; }
.size-options input:checked + span { border: 1.5px solid var(--ink); background: var(--lilac-pale); }
.price-line { display: flex; gap: 12px; margin: 17px 0 10px; font-size: 18px; }
.compare-price { text-decoration: line-through; }
.purchase-options { border: 0; margin: 0; padding: 0; display: grid; gap: 8px; }
.purchase-card { border: 1px solid var(--line); padding: 14px 13px; cursor: pointer; }
.purchase-card.selected { background: var(--lilac-pale); border-color: #dedcfa; }
.purchase-heading { display: flex; justify-content: space-between; align-items: center; gap: 14px; }
.purchase-card input { accent-color: var(--ink); width: 18px; height: 18px; vertical-align: middle; margin-right: 7px; }
.purchase-card select { width: 100%; border: 1px solid #cbc6c0; background: transparent; padding: 11px; margin-top: 12px; }
.purchase-card:not(.selected) select { display: none; }
.exclusive-offer-cta { display: grid; gap: 7px; margin: 13px 0 15px; border: 2px solid var(--ink); border-radius: 7px; background: var(--ink); color: #fff; padding: 17px 18px 16px; text-decoration: none; box-shadow: 0 7px 0 var(--lilac); transition: transform .18s ease, box-shadow .18s ease, background .18s ease; }
.exclusive-offer-cta:hover { transform: translateY(-2px); background: #322b52; box-shadow: 0 9px 0 var(--lilac); }
.exclusive-offer-cta:focus-visible { outline: 3px solid var(--lilac); outline-offset: 3px; }
.exclusive-offer-badge { width: fit-content; border-radius: 99px; background: var(--lilac); color: var(--ink); padding: 4px 10px; font-size: 11px; font-weight: 700; letter-spacing: .07em; line-height: 1.2; text-transform: uppercase; }
.exclusive-offer-cta > strong { font-family: "Barlow Semi Condensed", Arial, sans-serif; font-size: 21px; line-height: 1.08; letter-spacing: .025em; text-transform: uppercase; }
.exclusive-offer-cta small { display: flex; align-items: end; justify-content: space-between; gap: 18px; font-size: 13px; line-height: 1.25; }
.exclusive-offer-cta small span { max-width: 260px; color: #f4f0fb; }
.exclusive-offer-cta small b { flex: 0 0 auto; color: var(--lilac); font-size: 13px; text-transform: uppercase; text-decoration: underline; text-underline-offset: 3px; }
.pairing-card { display: grid; grid-template-columns: 98px 1fr; column-gap: 13px; row-gap: 2px; align-items: center; border: 0; background: var(--lilac); padding: 42px 8px 10px; position: relative; }
.pairing-title { position: absolute; top: 10px; left: 12px; margin: 0; text-transform: uppercase; font-weight: 700; font-size: 14px; }
.pairing-card img { width: 98px; height: 98px; grid-row: 1 / 3; border-radius: 7px; object-fit: cover; }
.pairing-image-link { grid-row: 1 / 3; display: block; }
.pairing-image-link img { grid-row: auto; }
.pairing-name-link { color: inherit; text-decoration: none; }
.pairing-name-link:hover { text-decoration: underline; text-underline-offset: 3px; }
.pairing-card div { display: grid; align-self: end; font-size: 16px; }.pairing-card small { color: #352f48; }.pairing-card div span { margin-top: 2px; font-weight: 600; }
.pair-check { grid-column: 2; align-self: start; width: max-content; cursor: pointer; font-weight: 600; text-transform: uppercase; text-decoration: underline; text-underline-offset: 3px; }.pair-check input { position: absolute; opacity: 0; }.pair-check span::before { content: "Add to Bag"; }.pair-check input:checked + span::before { content: "Added to Bag ✓"; }
.add-to-bag { width: 100%; display: flex; justify-content: space-between; border: 0; background: var(--ink); color: #fff; padding: 16px 20px; margin-top: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; cursor: pointer; transition: background .2s; }
.add-to-bag:hover { background: #393348; }
.shipping-note { display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 14px; margin: 11px 0 23px; }.shipping-note svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.5; }
.accordions { border-top: 1px solid var(--line); }
details { border-bottom: 1px solid var(--line); }
summary { cursor: pointer; list-style: none; font-weight: 600; padding: 17px 0; text-transform: uppercase; position: relative; }
summary::-webkit-details-marker { display: none; }
summary::after { content: "+"; position: absolute; right: 3px; font-size: 22px; line-height: 1; font-weight: 400; }
