  .drawer-line { grid-template-columns: 80px minmax(0, 1fr); padding: 20px; }.drawer-product-image { width: 80px; height: 100px; }.drawer-line img { width: 80px; height: 100px; }.drawer-line-meta { grid-column: 2; flex-direction: row; align-items: center; justify-content: space-between; }
  .shade-modal-card { padding: 45px 22px 28px; }.shade-modal-card h2 { font-size: 35px; }.shade-quiz { grid-template-columns: 1fr; }
  .quick-view-card { padding: 24px 20px; }.quick-shades > div { grid-template-columns: repeat(5, 37px); }.quick-add { margin-top: 22px; }
}

@media (prefers-reduced-motion: reduce) {
  * { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; }
}
