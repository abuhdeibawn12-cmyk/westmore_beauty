.accordion-content { padding: 0 12px 13px 0; color: #4d4952; }
.accordion-content p { margin: 0 0 10px; }
.claims { list-style: none; padding: 25px 0 0; margin: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 7px; }
.claims li { display: grid; justify-items: center; text-align: center; gap: 8px; font-size: 11px; line-height: 1.2; }.claims img { width: 42px; height: 42px; object-fit: contain; }

.section-kicker { margin: 0 0 10px; text-transform: uppercase; font-weight: 700; font-size: 14px; letter-spacing: .06em; }
.clinical h2 { font-size: 32px; }
.clinical { background: #f6f1ee; padding: 32px 0; }
.clinical-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
.clinical-slider { position: relative; min-width: 0; overflow: hidden; }
.clinical-track { display: flex; transition: transform .45s ease; }
.clinical-slide { flex: 0 0 100%; aspect-ratio: 1; }
.clinical-slide img { width: 100%; height: 100%; object-fit: cover; }
.clinical-arrow { position: absolute; z-index: 2; top: 50%; transform: translateY(-50%); width: 38px; height: 48px; border: 0; background: #fff9; font: 32px/1 Arial, sans-serif; cursor: pointer; opacity: 0; transition: opacity .2s; }
.clinical-slider:hover .clinical-arrow, .clinical-arrow:focus-visible { opacity: 1; }
.clinical-prev { left: 8px; }.clinical-next { right: 8px; }
.clinical-dots { position: absolute; z-index: 3; left: 50%; bottom: 14px; transform: translateX(-50%); display: flex; gap: 5px; }
.clinical-dots button { width: 9px; height: 9px; border: 0; border-radius: 50%; background: #fff; padding: 0; cursor: pointer; box-shadow: 0 0 0 1px #0001; }
.clinical-dots button.active { background: var(--ink); }
.clinical-copy h2 { margin-bottom: 30px; }
.clinical-copy p { display: grid; gap: 1px; margin: 0 0 16px; }
.clinical-copy strong { text-transform: uppercase; font-weight: 700; line-height: 1.2; }
.clinical-copy span { line-height: 1.35; }
.perfect-pair { padding: 32px 0; background: var(--lilac); }
.pair-inner > h2 { font-size: 32px; margin-bottom: 20px; }
.recommendations { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 68px; }
.recommendation-card { display: grid; grid-template-columns: 200px 1fr; gap: 14px; align-items: center; text-align: left; }
.recommendation-card > img { width: 200px; height: 200px; border-radius: 8px; background: #f6f1ee; object-fit: cover; }
.recommendation-product-link { display: block; width: 200px; height: 200px; border-radius: 8px; overflow: hidden; background: #f6f1ee; }
.recommendation-product-link img { width: 100%; height: 100%; object-fit: cover; }
.recommendation-card h3 a { color: inherit; text-decoration: none; }
.recommendation-card h3 a:hover { text-decoration: underline; text-underline-offset: 3px; }
.recommendation-card h3 { font-family: "Barlow Semi Condensed", Arial, sans-serif; font-size: 16px; line-height: 1.2; font-weight: 700; text-transform: uppercase; margin: 0 0 5px; }
.recommendation-card p { margin: 0 0 7px; }
.recommendation-rating span, .quick-review-link span { color: #43275f; letter-spacing: .5px; }
.recommendation-card strong { display: block; margin-bottom: 12px; }
.recommendation-card .recommendation-rating { display: block; min-width: 0; border: 0; border-radius: 0; background: transparent; color: var(--ink); padding: 0; margin: 0 0 7px; text-transform: none; letter-spacing: normal; font-weight: 400; cursor: pointer; text-align: left; }
.recommendation-card .recommendation-rating:hover { text-decoration: underline; text-underline-offset: 3px; }
.recommendation-card .recommendation-select { border: 0; border-radius: 7px; background: var(--ink); color: #fff; padding: 14px 22px; min-width: 140px; text-transform: uppercase; letter-spacing: .04em; font-weight: 600; cursor: pointer; }
.reviews { padding: 74px 0 88px; border-top: 1px solid var(--line); }
.review-summary { display: grid; grid-template-columns: 230px 315px; justify-content: center; gap: 42px; align-items: center; padding: 0 0 58px; }
.review-score { min-height: 120px; padding-right: 42px; border-right: 1px solid var(--line); display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }
