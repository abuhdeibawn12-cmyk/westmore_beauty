(function initializeWestmoreCart() {
  const listeners = new Set();
  const productRoute = "/collections/all?view=body-coverage-perfector";
  const brushRoute = "/collections/all?view=blend-blur-body-brush";
  const offerRoute = "/collections/all?view=bodycoverageperfector-exclusiveoffer";
  const catalogElement = document.querySelector("#westmore-commerce-catalog");

  let catalog = { root: "/", products: {} };
  let items = [];
  let cartState = { item_count: 0, total_price: 0, items: [] };
  let readyResolve;
  const ready = new Promise((resolve) => { readyResolve = resolve; });

  try {
    if (catalogElement?.textContent) catalog = JSON.parse(catalogElement.textContent);
  } catch (error) {
    console.error("Unable to read the Shopify product catalog.", error);
  }

  const root = String(window.Shopify?.routes?.root || catalog.root || "/").replace(/\/?$/, "/");
  const money = (value) => `$${Number(value).toFixed(2)}`;
  const cloneItems = () => items.map((item) => ({ ...item, properties: { ...item.properties } }));

  function normalizeUrl(value) {
    return String(value || "")
      .replace("/pages/bodycoverageperfector-exclusiveoffer", offerRoute)
      .replace("/products/body-coverage-perfector", productRoute)
      .replace("/products/blend-blur-body-brush", brushRoute);
  }

  function privateProperty(properties, name, fallback = "") {
    const value = properties && properties[name];
    return value == null ? fallback : String(value);
  }

  function normalizeCart(cart) {
    cartState = cart || { item_count: 0, total_price: 0, items: [] };
    items = (cartState.items || []).map((line) => {
      const properties = line.properties || {};
      const customKey = privateProperty(properties, "_westmore_key", line.key);
      const fallbackImage = line.featured_image?.url || line.image || "";
      return {
        key: customKey,
        lineKey: String(line.key),
        variantId: Number(line.variant_id || line.id),
        productHandle: String(line.handle || ""),
        name: privateProperty(properties, "_westmore_name", line.product_title || "Product"),
        detail: privateProperty(
          properties,
          "_westmore_detail",
          line.variant_title && line.variant_title !== "Default Title" ? line.variant_title : ""
        ),
        image: privateProperty(properties, "_westmore_image", fallbackImage),
        url: normalizeUrl(privateProperty(properties, "_westmore_url", line.url || "")),
        price: Number(line.final_price ?? line.price ?? 0) / 100,
        quantity: Math.max(1, Number(line.quantity) || 1),
        properties,
      };
    });
  }

  function notify() {
    const snapshot = cloneItems();
    listeners.forEach((listener) => listener(snapshot));
    window.dispatchEvent(new CustomEvent("westmore:cart-updated", {
      detail: { items: snapshot, count: getCount(), subtotal: getSubtotal() },
    }));
  }

  async function cartRequest(path, options = {}) {
    const response = await fetch(`${root}${path}`, {
      credentials: "same-origin",
      headers: {
        Accept: "application/json",
        ...(options.body ? { "Content-Type": "application/json" } : {}),
      },
      ...options,
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok) {
      const message = payload.description || payload.message || "Shopify could not update your bag.";
      throw new Error(message);
    }
    return payload;
  }

  function resolveVariantId(productHandle, option) {
    const variants = catalog.products?.[productHandle]?.variants || {};
    const variantId = Number(variants[option] || variants["Default Title"] || Object.values(variants)[0]);
    if (!variantId) {
      throw new Error("This product is being connected to checkout. Please refresh and try again shortly.");
    }
    return variantId;
  }

  function buildShopifyItem(item, quantity) {
    const safeQuantity = Math.max(1, Math.floor(Number(quantity) || 1));
    const variantId = Number(item.variantId) || resolveVariantId(item.productHandle, item.option);
    return {
      id: variantId,
      quantity: safeQuantity,
      properties: {
        _westmore_key: String(item.key || `${item.productHandle}|${item.option || variantId}`),
        _westmore_name: String(item.name || "Product"),
        _westmore_detail: String(item.detail || ""),
        _westmore_image: String(item.image || ""),
        _westmore_url: normalizeUrl(item.url),
      },
    };
  }

  async function refresh() {
    const cart = await cartRequest("cart.js");
    normalizeCart(cart);
    notify();
    return cloneItems();
  }

  async function addMany(entries) {
    await ready;
    const shopifyItems = entries.map(({ item, quantity = 1 }) => buildShopifyItem(item, quantity));
    await cartRequest("cart/add.js", {
      method: "POST",
      body: JSON.stringify({ items: shopifyItems }),
    });
    return refresh();
  }

  async function add(item, quantity = 1) {
    return addMany([{ item, quantity }]);
  }

  function findLine(key) {
    return items.find((item) => item.key === key || item.lineKey === key);
  }

  async function setQuantity(key, quantity) {
    await ready;
    const line = findLine(key);
    if (!line) return cloneItems();
    const safeQuantity = Math.max(0, Math.floor(Number(quantity) || 0));
    const cart = await cartRequest("cart/change.js", {
      method: "POST",
      body: JSON.stringify({ id: line.lineKey, quantity: safeQuantity }),
    });
    normalizeCart(cart);
    notify();
    return cloneItems();
  }

  async function remove(key) {
    return setQuantity(key, 0);
  }

  function getCount() {
    return items.reduce((total, item) => total + item.quantity, 0);
  }

  function getSubtotal() {
    return Number(cartState.total_price || 0) / 100;
  }

  function checkout() {
    if (getCount() === 0) return;
    window.location.assign(`${root}checkout`);
  }

  function createProductLink(item, className, child) {
    if (!item.url) return child;
    const link = document.createElement("a");
    link.className = className;
    link.href = item.url;
    link.append(child);
    return link;
  }

  function createGenericLine(item) {
    const article = document.createElement("article");
    article.className = "drawer-line";
    article.dataset.cartKey = item.key;

    const image = document.createElement("img");
    image.src = item.image;
    image.alt = item.name;
    article.append(createProductLink(item, "drawer-product-image", image));

    const copy = document.createElement("div");
    const heading = document.createElement("h3");
    const headingText = document.createElement("span");
    headingText.textContent = item.name;
    heading.append(createProductLink(item, "drawer-product-name", headingText));
    copy.append(heading);
    if (item.detail) {
      const detail = document.createElement("p");
      detail.textContent = item.detail;
      copy.append(detail);
    }
    const quantity = document.createElement("div");
    quantity.className = "quantity";
    const decrease = document.createElement("button");
    decrease.type = "button";
    decrease.dataset.cartAction = "decrease";
    decrease.textContent = "−";
    decrease.setAttribute("aria-label", `Decrease ${item.name} quantity`);
    const quantityValue = document.createElement("span");
    quantityValue.textContent = String(item.quantity);
    const increase = document.createElement("button");
    increase.type = "button";
    increase.dataset.cartAction = "increase";
    increase.textContent = "+";
    increase.setAttribute("aria-label", `Increase ${item.name} quantity`);
    quantity.append(decrease, quantityValue, increase);
    copy.append(quantity);
    article.append(copy);

    const meta = document.createElement("div");
    meta.className = "drawer-line-meta";
    const linePrice = document.createElement("strong");
    linePrice.textContent = money(item.price * item.quantity);
    const removeButton = document.createElement("button");
    removeButton.type = "button";
    removeButton.dataset.cartAction = "remove";
    removeButton.textContent = "Remove";
    removeButton.setAttribute("aria-label", `Remove ${item.name} from bag`);
    meta.append(linePrice, removeButton);
    article.append(meta);
    return article;
  }

  function renderGenericCart(options = {}) {
    const countBadges = [...document.querySelectorAll(options.countBadges || ".cart-count")];
    const headerCount = document.querySelector(options.headerCount || ".drawer-count");
    const empty = document.querySelector(options.empty || ".drawer-empty");
    const itemsContainer = document.querySelector(options.items || ".drawer-items");
    const footer = document.querySelector(options.footer || ".drawer-footer");
    const subtotal = document.querySelector(options.subtotal || ".drawer-subtotal");
    const checkoutButton = document.querySelector(options.checkout || "[data-cart-checkout]");
    const count = getCount();

    countBadges.forEach((badge) => {
      badge.textContent = String(count);
      badge.classList.toggle("visible", count > 0);
      badge.setAttribute("aria-label", `${count} ${count === 1 ? "item" : "items"}`);
    });
    if (headerCount) headerCount.textContent = `(${count})`;
    if (empty) empty.hidden = count > 0;
    if (footer) footer.hidden = count === 0;
    if (subtotal) subtotal.textContent = money(getSubtotal());
    if (checkoutButton) {
      checkoutButton.disabled = count === 0;
      if (!checkoutButton.dataset.cartCheckoutBound) {
        checkoutButton.dataset.cartCheckoutBound = "true";
        checkoutButton.addEventListener("click", checkout);
      }
    }
    if (itemsContainer) {
      itemsContainer.replaceChildren(...items.map(createGenericLine));
      itemsContainer.onclick = async (event) => {
        const button = event.target.closest("button[data-cart-action]");
        const line = button?.closest("[data-cart-key]");
        const item = line && findLine(line.dataset.cartKey);
        if (!button || !item) return;
        button.disabled = true;
        try {
          if (button.dataset.cartAction === "increase") await setQuantity(item.key, item.quantity + 1);
          if (button.dataset.cartAction === "decrease") await setQuantity(item.key, item.quantity - 1);
          if (button.dataset.cartAction === "remove") await remove(item.key);
        } catch (error) {
          window.dispatchEvent(new CustomEvent("westmore:cart-error", { detail: { message: error.message } }));
          button.disabled = false;
        }
      };
    }
  }

  function subscribe(listener) {
    listeners.add(listener);
    return () => listeners.delete(listener);
  }

  window.WestmoreCart = {
    add,
    addMany,
    remove,
    setQuantity,
    refresh,
    ready,
    checkout,
    getItems: cloneItems,
    getCount,
    getSubtotal,
    money,
    renderGenericCart,
    subscribe,
    resolveVariantId,
  };

  refresh()
    .catch((error) => {
      console.error("Unable to load the Shopify cart.", error);
      window.dispatchEvent(new CustomEvent("westmore:cart-error", { detail: { message: error.message } }));
    })
    .finally(readyResolve);
})();
